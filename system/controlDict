FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
functions
{
    forces1
    {
        type            forces;
        libs            ("libforces.so");
        patches         (blade_surface);     // Replace with your patch name
        rho             rhoInf;         // For incompressible solvers
        rhoInf          1.225;          // Density of air (kg/m3)
        CofR            (0 0 0);        // Center of Rotation for moments
        writeControl    timeStep;
        writeInterval   1;
    }

    WSS
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (blade_surface); // Use your actual patch name
        writeControl    writeTime;
    }
}
application     simpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         2500;
deltaT          1;
writeControl    timeStep;
writeInterval   50;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
runTimeModifiable true;
