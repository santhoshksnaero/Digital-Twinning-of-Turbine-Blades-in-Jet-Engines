FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    blade_surface
    {
        type    searchableCylinder;
        point1  (0.5 0 -0.1);
        point2  (0.5 0  0.1);
        radius  0.1;
    }
};

castellatedMeshControls
{
    features ();
    maxLocalCells 1000000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    nCellsBetweenLevels 3;
    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces true;

    refinementSurfaces
    {
        blade_surface
        {
            level (3 4);
        }
    }
    refinementRegions {}
    locationInMesh (0.1 0.1 0);
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 10;
}

addLayersControls {}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.02;
    minVolRatio 0.01;
    mustSinkPositivePureUpwind true;
    minTriangleTwist -1;
    minFlatness 0.5;
    errorReduction 0.75;
    nSmoothScale 4;
}

mergeTolerance 1e-6;
