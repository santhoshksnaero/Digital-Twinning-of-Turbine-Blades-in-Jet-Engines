FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.01 0 0);

boundaryField
    {
        inlet
        {
            type            fixedValue;
            value           uniform (10 0 0); // Adjust (10 0 0) to your air speed
        }
        outlet
        {
            type            zeroGradient;
        }
        blade_surface
        {
            type            noSlip;
        }
        walls
        {
            type            noSlip;
        }
        frontAndBack
        {
            type            empty;
        }
        // ... ensure upperWall and lowerWall are also defined correctly (e.g., slip)
    }
